<% if (it.envImport) { -%>
<%= it.envImport %>
<% } -%>
import Bugsnag from "@bugsnag/js";

// Initialise once at module import; consumers re-export `Bugsnag` and call
// `.notify(err)` / `.leaveBreadcrumb(...)` where they need it. For a Next.js
// app that wants automatic instrumentation, install `@bugsnag/plugin-next` and
// pass it under `plugins:` here.
Bugsnag.start({
  apiKey: <%= it.envRef("BUGSNAG_API_KEY") %>,
});

export { Bugsnag };
