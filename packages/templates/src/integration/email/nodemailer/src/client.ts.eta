<% if (it.envImport) { -%>
<%= it.envImport %>
<% } -%>
import nodemailer from "nodemailer";

const transporter = nodemailer.createTransport({
  host: <%= it.envRefOpt("SMTP_HOST") %>,
  port: Number(<%= it.envRefOpt("SMTP_PORT") %> ?? 587),
  secure: <%= it.envRefOpt("SMTP_SECURE") %> === "true",
  auth: {
    user: <%= it.envRefOpt("SMTP_USER") %>,
    pass: <%= it.envRefOpt("SMTP_PASS") %>,
  },
});

export async function sendEmail({
  to,
  subject,
  html,
  text,
}: {
  to: string | string[];
  subject: string;
  html?: string;
  text?: string;
}) {
  return transporter.sendMail({
    from: <%= it.envRefOpt("EMAIL_FROM") %> ?? "noreply@example.com",
    to: Array.isArray(to) ? to.join(", ") : to,
    subject,
    html,
    text,
  });
}
