<% if (it.envImport) { -%>
<%= it.envImport %>
<% } -%>
import { Redis } from "@upstash/redis";
import type { CacheProvider } from "./types";

/**
 * Upstash Redis (serverless, REST-based) implementation of CacheProvider.
 * `@upstash/redis` already JSON-serialises values, so we pass them through.
 */
const redis = new Redis({
  url: <%= it.envRef("UPSTASH_REDIS_REST_URL") %>,
  token: <%= it.envRef("UPSTASH_REDIS_REST_TOKEN") %>,
});

class UpstashCache implements CacheProvider {
  async get<T = unknown>(key: string): Promise<T | null> {
    return (await redis.get<T>(key)) ?? null;
  }
  async set(key: string, value: unknown, ttlSeconds?: number): Promise<void> {
    if (ttlSeconds && ttlSeconds > 0) {
      await redis.set(key, value, { ex: ttlSeconds });
    } else {
      await redis.set(key, value);
    }
  }
  async del(key: string): Promise<void> {
    await redis.del(key);
  }
  async has(key: string): Promise<boolean> {
    return (await redis.exists(key)) === 1;
  }
}

export const cache: CacheProvider = new UpstashCache();
