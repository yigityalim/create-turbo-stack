/**
 * Provider-neutral cache contract. The package's root re-exports the active
 * provider's instance as `cache`; consumers depend on this interface, never on
 * the underlying client. Swapping providers later means replacing only
 * `./client` — no consumer code changes.
 */
export interface CacheProvider {
  /** Read a value. Returns `null` when the key is missing. */
  get<T = unknown>(key: string): Promise<T | null>;
  /** Write a value, optionally with a TTL in seconds. */
  set(key: string, value: unknown, ttlSeconds?: number): Promise<void>;
  /** Remove a key. No-op if missing. */
  del(key: string): Promise<void>;
  /** Check existence without fetching the value. */
  has(key: string): Promise<boolean>;
}
