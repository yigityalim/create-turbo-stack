import { createEnv } from "@t3-oss/env-nextjs";
import { z } from "zod";

export const env = createEnv({
<% if (it.serverVars.length > 0) { -%>
  server: {
<% for (const v of it.serverVars) { -%>
    <%= v.name %>: <%= v.zodType %>,
<% } -%>
  },
<% } -%>
<% if (it.clientVars.length > 0) { -%>
  client: {
<% for (const v of it.clientVars) { -%>
    <%= v.name %>: <%= v.zodType %>,
<% } -%>
  },
<% } -%>
<% const runtimeVars = it.serverVars.concat(it.clientVars); -%>
<% if (runtimeVars.length > 0) { -%>
  runtimeEnv: {
<% for (const v of runtimeVars) { -%>
    <%= v.name %>: process.env.<%= v.name %>,
<% } -%>
  },
<% } else { -%>
  runtimeEnv: {},
<% } -%>
  // Set SKIP_ENV_VALIDATION=1 for builds without secrets (Docker, CI).
  skipValidation: !!process.env.SKIP_ENV_VALIDATION,
  emptyStringAsUndefined: true,
});
