{
  "$schema": "https://create-turbo-stack.dev/schema/preset.json",
  "schemaVersion": "1.0",
  "name": "turbo-stack",
  "version": "1.0.0",
  "description": "Grouped-by-surface Turborepo: bun + Biome, foundation packages (errors/logger/flags/types/crypto/security/session), Supabase, a standalone Hono API, Next.js marketing + admin, and an Expo app.",
  "basics": {
    "projectName": "turbo-stack",
    "packageManager": "bun",
    "scope": "@repo",
    "typescript": "strict",
    "linter": "biome",
    "gitInit": true
  },
  "database": { "strategy": "supabase" },
  "api": { "strategy": "none" },
  "auth": { "provider": "none", "rbac": false, "entitlements": false },
  "css": { "framework": "tailwind4", "ui": "shadcn", "styling": "css-variables" },
  "integrations": {
    "analytics": "none",
    "errorTracking": "none",
    "email": "resend",
    "rateLimit": "none",
    "ai": "none",
    "cache": "none",
    "envValidation": "t3-env"
  },
  "apps": [
    {
      "name": "web",
      "type": "nextjs",
      "location": "apps/marketing",
      "port": 3000,
      "i18n": true,
      "consumes": ["ui", "env"]
    },
    {
      "name": "admin",
      "type": "nextjs",
      "location": "apps/marketing",
      "port": 3001,
      "i18n": false,
      "consumes": ["ui", "env", "db"]
    },
    {
      "name": "api",
      "type": "hono-standalone",
      "location": "apps",
      "port": 3002,
      "i18n": false,
      "consumes": ["env", "db", "email"]
    },
    {
      "name": "mobile",
      "type": "expo",
      "location": "apps",
      "port": 8081,
      "i18n": false,
      "consumes": ["env"]
    }
  ],
  "packages": [
    { "name": "ui", "type": "react-library", "location": "packages", "producesCSS": true, "exports": ["."] }
  ],
  "registryPackages": ["types", "errors", "logger", "flags", "crypto", "security", "session"],
  "autoPackageLocations": {
    "typescript-config": "tooling",
    "email": "packages/infra"
  }
}
