{
  "$schema": "https://create-turbo-stack.dev/schema/package-registry.json",
  "name": "create-turbo-stack",
  "homepage": "https://create-turbo-stack.dev",
  "items": [
    {
      "name": "security",
      "type": "registry:package",
      "title": "Security",
      "description": "Security headers (CSP, HSTS, X-Frame-Options, …) plus an origin/CSRF guard for Next.js and Web-API handlers.",
      "dependencies": [],
      "exports": [".", "./headers", "./middleware"],
      "lib": ["ES2022", "DOM"],
      "build": "none",
      "files": [
        { "path": "security/src/index.ts", "type": "registry:source", "target": "src/index.ts" },
        { "path": "security/src/headers.ts", "type": "registry:source", "target": "src/headers.ts" },
        {
          "path": "security/src/middleware.ts",
          "type": "registry:source",
          "target": "src/middleware.ts"
        }
      ]
    },
    {
      "name": "crypto",
      "type": "registry:package",
      "title": "Crypto",
      "description": "Web Crypto helpers: SHA-256 / HMAC hashing and secure random tokens.",
      "dependencies": [],
      "exports": [".", "./hash", "./random"],
      "lib": ["ES2022", "DOM"],
      "build": "none",
      "files": [
        { "path": "crypto/src/index.ts", "type": "registry:source", "target": "src/index.ts" },
        { "path": "crypto/src/hash.ts", "type": "registry:source", "target": "src/hash.ts" },
        { "path": "crypto/src/random.ts", "type": "registry:source", "target": "src/random.ts" }
      ]
    },
    {
      "name": "session",
      "type": "registry:package",
      "title": "Session",
      "description": "Secure session id helpers — composes the crypto package.",
      "registryDependencies": ["crypto"],
      "exports": ["."],
      "lib": ["ES2022", "DOM"],
      "files": [
        { "path": "session/src/index.ts", "type": "registry:source", "target": "src/index.ts" }
      ]
    }
  ]
}
